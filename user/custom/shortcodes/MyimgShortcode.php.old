<?php
namespace Grav\Plugin\Shortcodes;

use Thunder\Shortcode\Shortcode\ShortcodeInterface;

class MyimgShortcode extends Shortcode
{
    public function init()
    {
        $this->shortcode->add('myimg', function(ShortcodeInterface $sc) {
            // Récupération des attributs du shortcode
            $filename = $sc->getParameter('src', $sc->getBbCode());
            $alt_param = $sc->getParameter('alt');

            if (!$filename) {
                return '';
            }

            // Récupération de la page courante
            $page = $this->grav['page'];
            
            // Extraction du nom de base et de l'extension
            $basename = pathinfo($filename, PATHINFO_FILENAME);
            $extension = strtolower(pathinfo($filename, PATHINFO_EXTENSION));

            // Recherche intelligente de l'image (indépendante de l'extension)
            $image = null;
            foreach ($page->media()->images() as $file) {
                if (pathinfo($file->filename, PATHINFO_FILENAME) === $basename) {
                    $image = $file;
                    break;
                }
            }

            // Si aucune image n'est trouvée, sécurité HTML
            if (!$image) {
                return "<!-- Image [img] manquante dans le dossier : $basename -->";
            }

            // Définition du texte alternatif (alt) prioritaires ou fallback sur le nom du fichier
            $alt_text = $alt_param ?? $basename;
            $alt_clean = htmlspecialchars($alt_text, ENT_QUOTES, 'UTF-8');

            // Génération des tailles dérivées pour le srcset
            $derivatives = $image->derivatives(400, 1200, 400);

            if ($extension === 'avif') {
                // Si la source est nativement en AVIF, on évite les conversions JPG/WebP risquées
                $avifSrcset = $derivatives->srcset();
                $webpSrcset = $avifSrcset;
                $jpegSrcset = $avifSrcset;
                // url(false) empêche Grav de recalculer un JPG dans le dossier /images/
                $fallbackUrl = $image->resize(1200)->url(false); 
            } else {
                // Si la source d'origine était un JPG ou PNG, Grav s'occupe des formats alternatifs
                try {
                    $avifSrcset = $derivatives->format('avif')->srcset();
                    $webpSrcset = $derivatives->format('webp')->srcset();
                    $jpegSrcset = $derivatives->srcset();
                    $fallbackUrl = $image->resize(1200)->url();
                } catch (\Exception $e) {
                    $avifSrcset = $derivatives->srcset();
                    $webpSrcset = $avifSrcset;
                    $jpegSrcset = $avifSrcset;
                    $fallbackUrl = $image->resize(1200)->url(false);
                }
            }

            // Échafaudage du HTML final avec des doubles quotes strictes
            $html = '<picture class="wrapper-photo-stages-ateliers">';

            if ($extension === 'avif') {
                // Rendu optimisé et léger pour de l'AVIF natif (sans doublons inutiles de balises sources)
                $html .= '<source type="image/avif" srcset="' . $avifSrcset . '" sizes="(max-width:400px) 33vw, (max-width:800px) 55vw, 100vw">';
            } else {
                // Rendu multi-formats si l'image de base le permet
                $html .= '<source type="image/avif" srcset="' . $avifSrcset . '" sizes="(max-width:400px) 33vw, (max-width:800px) 55vw, 100vw">';
                $html .= '<source type="image/webp" srcset="' . $webpSrcset . '" sizes="(max-width:400px) 33vw, (max-width:800px) 55vw, 100vw">';
                $html .= '<source type="image/jpeg" srcset="' . $jpegSrcset . '" sizes="(max-width:400px) 33vw, (max-width:800px) 55vw, 100vw">';
            }

            // Balise img finale (Fallback pour les vieux navigateurs et support du Alt)
            $html .= '<img src="' . $fallbackUrl . '" alt="' . $alt_clean . '" class="photo-stages-ateliers" loading="lazy">';
            $html .= '</picture>';

            return $html;
        });
    }
}