{% extends 'main-layout.html.twig' %}

{% block content %}
{# --- TRAITEMENT ET DÉCOUPE DES BLOCS SÉCURISÉS --- #}
{% set contenu_traite = page.content %}

{# Étape 1 : Isolation du bloc principal avant l'occitan #}
{% set split_occitan = contenu_traite|split('---SECTION_OCCITAN---') %}
{% set bloc_principal = split_occitan[0] | default('') %}

{# Étape 2 : Séparation de l'occitan et de l'extrait #}
{% set reste = split_occitan[1] | default('') %}
{% set split_extrait = reste|split('---SECTION_EXTRAIT---') %}

{% set bloc_occitan = split_extrait[0] | default('') %}
{% set bloc_extrait = split_extrait[1] | default('') %}

{# --- PRÉPARATION DES GRILLES ET CONTENUS COMPLEXES (Vos shortcodes d'origine) --- #}
{% set grid_html %}
    <p class="g_sp_spectacles">
        [a class="g_sp_theatre-d-ombres morph" url="gresilhette-et-la-salimonde/theatre-d-ombres"]
            {{ page.media['sp_theatre-d-ombres.avif'].html('Spectacle Grésilhette et la Salimonde - Théâtre d\'ombres') | raw }}
        [/a]
        [a class="g_sp_sieste-contee morph" url="gresilhette-et-la-salimonde/sieste-contee"]
            {{ page.media['sp_sieste-contee.avif'].html('La sieste contée - Grésilhette et la Salimonde') | raw }}
        [/a]
        [a class="g_sp_projet-pedagogique morph" url="gresilhette-et-la-salimonde/projet-pedagogique"]
            {{ page.media['sp_projet-pedagogique.avif'].html('Le projet pédagogique - Grésilhette et la Salimonde') | raw }}
        [/a]
    </p>
{% endset %}

{% set pdf_html %}
    [a url="gresilhette-et-la-salimonde/dossier-prez_compressed.pdf" title="Visualiser le dossier artistique Grésilhette et la Salimonde de la compagnie Les Mégères de l'Humus"]
        {{ page.media[page.header.spectacle.dossier_img].html('', '', 'btn-pdf') | raw }}
    [/a]
{% endset %}

{# On force l'interprétation des shortcodes contenus dans nos variables #}
{% set grid_html_traite = grid_html | shortcode %}
{% set pdf_html_traite = pdf_html | shortcode %}


{# ================================================================== #}
{#                       RENDU DE LA PAGE HTML                        #}
{# ================================================================== #}

<main>
    <section>
        {# Habillage commun du haut #}
        <div class="conteneur-champignons">
            <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
            <h1>{{ page.title }}</h1>
            {% if page.header.subtitle %}<p class="sous-titre">{{ page.header.subtitle | raw }}</p>{% endif %}
        </div>
        
        {# --- 1. DIV : BLOC PRINCIPAL SPECTACLE --- #}
        <div class="encadre">
            <div class="gresilhette-et-la-salimonde">
                <h2 class="coco">{{ page.header.spectacle.age_duree }}</h2>

                {# --- LECTEUR VIDÉO COMPLET D'ORIGINE --- #}
                <div class="wrapper-video">
                    <video id="video" controls preload="auto" loading="metadata" width="640" height="360">
                        {% if page.media[page.header.spectacle.video.mp4] %}
                            <source src="{{ page.media[page.header.spectacle.video.mp4].url }}" type="video/mp4" />
                        {% endif %}
                        {% if page.media[page.header.spectacle.video.webm] %}
                            <source src="{{ page.media[page.header.spectacle.video.webm].url }}" type="video/webm" />
                        {% endif %}
                        Votre navigateur ne prend pas en charge la lecture vidéo HTML5.
                    </video>

                    <div class="custom-video-controls">
                        <button id="playPauseBtn" class="control-btn" aria-label="Play/Pause">
                            <svg class="play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            <svg class="pause-icon" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                        </button> 
                        <input type="range" id="progress" min="0" max="100" value="0" step="0.1">
                        <span id="time" class="time-display">0:00 / 0:00</span>

                        <div class="volume-control-zone">
                            <button id="muteBtn" class="control-btn" aria-label="Mute/Unmute">
                                <svg class="sound-icon" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                                <svg class="mute-icon" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.21.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
                            </button>
                            <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="1" aria-label="Volume">
                        </div>
                        <button id="fullscreenBtn" class="control-btn" aria-label="Plein écran">
                            <svg class="fs-icon" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                            <svg class="exit-fs-icon" viewBox="0 0 24 24"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
                        </button>
                    </div>
                </div>
                {# Début div g_spectacles #}
                <div class="g_spectacles">
                    {# 1. On coupe le bloc principal au niveau du tag [versions-grid] #}
                    {% set parties_spectacle = bloc_principal | split('[versions-grid]') %}
                    {% set intro_texte = parties_spectacle[0] | default('') %}
                    {% set suite_texte = parties_spectacle[1] | default('') %}
                
                    {# 2. RENDU DE L'INTRO : Un affichage pur et direct, sans aucune manipulation de chaîne #}
                    {{ intro_texte | trim | shortcodes | markdown | raw }}

                
                    {# 3. RENDU DE LA GRILLE : AUCUNE DIV AUTOUR, ET PAS DE FILTRE MARKDOWN. #}
                    {# On l'écrit sur une seule ligne Twig compacte pour éviter que Grav ne recrée un espace #}
                    {{ grid_html | trim | shortcodes | raw }}
                
                    {# 4. RENDU DE LA SUITE : On injecte d'abord le bouton PDF à la place du repère textuel #}
                    {% set suite_html = suite_texte | replace({'[dossier-artistique]': pdf_html}) %}
                       
                    {# Puis on applique la classe sur le générique final #}
                    {% set suite_html = suite_html | replace({
                        '<p>Écriture, mise en scène': '<p class="p_terra g_sp_e-generique">Écriture, mise en scène'
                    }) %}
                       
                    {# On applique enfin les shortcodes et le markdown pour rendre le lien actif et afficher l'image #}
                    {{ suite_html | trim | shortcodes | markdown | raw }}

                </div>
                {# fin div g_spectacles #}
            </div>
        </div>

        {# --- 2. BLOC : OCCITAN --- #}
        {% if bloc_occitan|trim is not empty %}
        <div class="encadre-lenga">
            <div class="la-lenga-occitana">
                {# On appelle la variable occitan avec sa classe #}
                <h2 class="display-title">{{ page.header.titre_occitan }}</h2>
                {{ bloc_occitan | shortcodes | markdown | raw }}
            </div>
        </div>
        {% endif %}
        
        {# --- 3. BLOC : EXTRAIT --- #}
        {% if bloc_extrait|trim is not empty %}
        <div class="encadre-extrait">
            <div class="extrait">
                {# On appelle la variable extrait avec sa classe #}
                <h2 class="display-title">{{ page.header.titre_extrait }}</h2>
                {{ bloc_extrait | shortcodes | markdown | raw }}
            </div>
        </div>
        {% endif %}

    </section>
</main>
{% endblock %}