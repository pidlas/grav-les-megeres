{% extends 'main-layout.html.twig' %}

{% block content %}

{# --- CHARGEMENT DU BLOC FLEX QUEL QUE SOIT LE HASH --- #}
{% set collection = grav.flex.directory('gresilhette-et-la-salimonde').getCollection() %}
{% set gresilhette_flex = collection.first() %}

{# Sécurité : si gresilhette_flex est vide, on cherche directement dans l'en-tête de la page d'origine #}
{% if gresilhette_flex is empty %}
    {% set gresilhette_flex = page.header %}
{% endif %}

{# --- TRAITEMENT ET DÉCOUPE DES BLOCS SÉCURISÉS --- #}
{% set contenu_traite = page.content %}

{# Il n'y a plus d'Occitan dans le texte, on coupe directement à l'Extrait #}
{% set split_extrait = contenu_traite|split('---SECTION_EXTRAIT---') %}

{% set bloc_principal = split_extrait[0] | default('') %}
{% set bloc_extrait = split_extrait[1] | default('') %}


{# --- PRÉPARATION DES GRILLES ET CONTENUS COMPLEXES (Vos shortcodes d'origine) --- #}
{# 👇 COMPACTÉ SUR UNE SEULE LIGNE : Empêche le Markdown d'injecter des <p> parasites #}
{% set grid_html %}<p class="g_sp_spectacles">[a class="g_sp_theatre-d-ombres morph" url="gresilhette-et-la-salimonde/theatre-d-ombres"]{{ page.media['sp_theatre-d-ombres.avif'].html('Spectacle Grésilhette et la Salimonde - Théâtre d\'ombres') | raw }}[/a][a class="g_sp_sieste-contee morph" url="gresilhette-et-la-salimonde/sieste-contee"]{{ page.media['sp_sieste-contee.avif'].html('La sieste contée - Grésilhette et la Salimonde') | raw }}[/a][a class="g_sp_projet-pedagogique morph" url="gresilhette-et-la-salimonde/projet-pedagogique"]{{ page.media['sp_projet-pedagogique.avif'].html('Le projet pédagogique - Grésilhette et la Salimonde') | raw }}[/a]</p>{% endset %}


{# 👇 RECONSTRUCTION DYNAMIQUE ET SÉCURISÉE DU BLOC PDF AVEC LE FILEPICKER #}
{% set pdf_html %}
    {% set fichier_pdf = gresilhette_flex.spectacle.dossier_pdf ? page.media[gresilhette_flex.spectacle.dossier_pdf|trim] : null %}
    {% set bouton_img = gresilhette_flex.spectacle.dossier_img ? page.media[gresilhette_flex.spectacle.dossier_img|trim] : null %}
    
    {% if bouton_img and fichier_pdf %}
        [a url="{{ fichier_pdf.url }}" title="Visualiser le dossier artistique Grésilhette et la Salimonde de la compagnie Les Mégères de l'Humus"]
            {{ bouton_img.html('', '', 'btn-pdf') | raw }}
        [/a]
    {% endif %}
{% endset %}

{# On force l'interprétation des shortcodes contenus dans nos variables #}
{% set grid_html_traite = grid_html | shortcodes %}
{% set pdf_html_traite = pdf_html | shortcodes %}

{# ================================================================== #}
{#                       RENDU DE LA PAGE HTML                        #}
{# ================================================================== #}

<main>
    <section class="{{ page.slug }}">

        {# --- 1. DIV : BLOC PRINCIPAL SPECTACLE --- #}
        <div class="encadre">
            <div class="gresilhette-et-la-salimonde">
                <h2 class="coco">{{ gresilhette_flex.spectacle.age_duree }}</h2>

                {# --- LECTEUR VIDÉO COMPLET D'ORIGINE --- #}
                <div class="wrapper-video">
                    <video id="video" controls preload="auto" loading="metadata" width="640" height="360">
                        {% if gresilhette_flex.spectacle.video.mp4 and page.media[gresilhette_flex.spectacle.video.mp4|trim] %}
                            <source src="{{ page.media[gresilhette_flex.spectacle.video.mp4|trim].url }}" type="video/mp4" />
                        {% endif %}
                        {% if gresilhette_flex.spectacle.video.webm and page.media[gresilhette_flex.spectacle.video.webm|trim] %}
                            <source src="{{ page.media[gresilhette_flex.spectacle.video.webm|trim].url }}" type="video/webm" />
                        {% endif %}
                        Votre navigateur ne prend pas en charge la lecture vidéo HTML5.
                    </video>

                    <div class="custom-video-controls">
                        <button id="playPauseBtn" class="control-btn" aria-label="Play/Pause">
                            <svg class="play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            <svg class="pause-icon" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                        </button> 
                        <input type="range" id="progress" min="0" max="100" value="0" step="0.1">
                        <span id="time" class="time-display">0:00 / 0:00</span>

                        <div class="volume-control-zone">
                            <button id="muteBtn" class="control-btn" aria-label="Mute/Unmute">
                                <svg class="sound-icon" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                                <svg class="mute-icon" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.21.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
                            </button>
                            <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="1" aria-label="Volume">
                        </div>
                        <button id="fullscreenBtn" class="control-btn" aria-label="Plein écran">
                            <svg class="fs-icon" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                            <svg class="exit-fs-icon" viewBox="0 0 24 24"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
                        </button>
                    </div>
                </div>
                {# Début div g_spectacles #}
                <div class="g_spectacles">
                    {# 1. On coupe le bloc principal au niveau du tag [versions-grid] #}
                    {% set parties_spectacle = bloc_principal | split('[versions-grid]') %}
                    {% set intro_texte = parties_spectacle[0] | default('') %}
                    {% set suite_texte = parties_spectacle[1] | default('') %}
                
                    {# 2. RENDU DE L'INTRO #}
                    {{ intro_texte | trim | shortcodes | markdown | raw }}

                    {# 3. RENDU DE LA GRILLE #}
                    {{ grid_html_traite | raw }}
                
                    {# 4. RENDU DE LA SUITE #}
                    {% set suite_html = suite_texte | replace({'[dossier-artistique]': pdf_html_traite}) %}
                       
                    {% set suite_html = suite_html | replace({
                        '<p>Écriture, mise en scène': '<p class="p_terra g_sp_e-generique">Écriture, mise en scène'
                    }) %}
                       
                    {{ suite_html | trim | shortcodes | markdown | raw }}
                </div>
                {# fin div g_spectacles #}
            </div>
        </div>

        {# --- 2. BLOC : OCCITAN (GÉRÉ PAR FLEX OBJECT) --- #}
        {% if gresilhette_flex.getProperty('titre_occitan') %}
        <div class="encadre-lenga">
            <div class="la-lenga-occitana">
                <h2 class="display-title">{{ gresilhette_flex.getProperty('titre_occitan') }}</h2>
        
                {# On boucle sur les paragraphes saisis dans l'admin #}
                {% for bloc in gresilhette_flex.getProperty('occitan_paragraphes') %}
                    {% if bloc.texte_fr is not empty %}
                        <p>{{ bloc.texte_fr | markdown | raw }}</p>
                    {% endif %}
                   
                    {% if bloc.texte_oc is not empty %}
                        {# La classe "tresgras" s'applique automatiquement ici #}
                        <p class="tresgras">{{ bloc.texte_oc | markdown(false) | raw }}</p>
                    {% endif %}
                {% endfor %}
       
                {# Affichage de la ligne de traduction avec sa classe spécifique #}
                {% if gresilhette_flex.getProperty('traduction_signature') %}
                    <p class="traduction">traduction : {{ gresilhette_flex.getProperty('traduction_signature') }}</p>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {# --- 3. BLOC : EXTRAIT --- #}
        {% if bloc_extrait|trim is not empty %}
        <div class="encadre-extrait">
            <div class="extrait">
                {# <h2 class="display-title">{{ page.header.titre_extrait }}</h2> #}
                <h2 class="display-title">{{ gresilhette_flex.getProperty('titre_extrait') }}</h2>
                {{ bloc_extrait | shortcodes | markdown | raw }}
            </div>
        </div>
        {% endif %}
        
    </section>
</main>
{% endblock %}