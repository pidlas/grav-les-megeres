{% extends 'main-layout.html.twig' %}

{% block content %}
<main>
    <section>
        {# 1. Bloc décoratif fixe du thème #}
        <div class="conteneur-champignons">
            <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
            <h1>{{ page.title }}</h1>
            {% if page.header.subtitle %}
                <p class="sous-titre">{{ page.header.subtitle | raw }}</p>
            {% endif %}
        </div>

        {# 2. Collecte et affichage forcé des 3 blocs par leur route physique #}
        {% set intro = pages.find('/infos/compagnie/_1-intro') %}
        {% set details = pages.find('/infos/compagnie/_2-details') %}
        {% set galerie = pages.find('/infos/compagnie/_3-galerie-liens') %}

        {% if intro %}{{ intro.content|raw }}{% endif %}
        {% if details %}{{ details.content|raw }}{% endif %}
        {% if galerie %}{{ galerie.content|raw }}{% endif %}
        
    </section>
</main>
{% endblock %}
