{% extends 'main-layout.html.twig' %}

{# 🌟 ÉTAPE 1 : ON ÉTEINT L'AFFICHAGE DU HAUT D'ORIGINE et celui des feuilles qui seraient affichées sous le titre #}
{% block content %}{% endblock %}
{% block decor_feuilles %}{% endblock %}

{# 🌟 ÉTAPE 2 : LE BLOC MAÎTRE POUR L'ACCUEIL #}
{% block avant_conteneur_texte %}
    
    {# A. L'ACCORDÉON DIAPORAMA (1200,03px de front) #}
    {% include 'partials/diaporama.html.twig' with {'la_page_accueil': page} %}
    
    {# B. LA MISE AU DIAPASON SPECTRE AVEC VOTRE <SECTION CLASS="INDEX">
       Justification : Le texte éditorial s'installe au cœur de la grille élastique,
       parfaitement encapsulé dans votre balise sémantique dédiée. #}
    <div class="container mt-2">
        <div class="columns">
            <div class="column col-12">
                <section class="index">
                    {{ page.content | shortcodes | raw }}
                </section>
            </div>
        </div>
    </div>
    {# 🌟 C. TÉLÉPORTATION DU DÉCOR
       Justification : On rappelle le contenu du bloc d'origine du fichier maître,
       mais on force son affichage au sol, juste au-dessus du footer. #}
    {{ block('decor_feuilles', 'main-layout.html.twig') }}

{% endblock %}
