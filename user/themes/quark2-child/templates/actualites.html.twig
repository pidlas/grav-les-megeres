{% extends 'main-layout.html.twig' %}

{# ==========================================================================
   AFFICHAGE DU CONTENU DE LA PAGE (Le corps du site)
   ========================================================================== #}
{% block content %}
    {# 1. Enveloppe sémantique globale propre pour le contenu textuel #}
    <div class="page-content">
        {{ page.content | raw }}
    </div>

    {# 2. Récupération propre de la collection via l'extracteur Flex unifié #}
    {% set actualites_flex = grav.flex.directory('actualites').getCollection() %}

    {# Zone dynamique de la liste des Actualités #}
    {% if actualites_flex is not empty %}
    <div class="actus-list" aria-live="polite">
        {% for item in actualites_flex %}
            <article class="actu-item">
                
                {# Image principale de la catégorie actu depuis le dossier user/data #}
                {% if item.image_principale %}
                    <img src="{{ base_url_simple ~ '/' ~ 'user/data/flex-objects/actualites/' ~ item.image_principale }}" alt="{{ item.image_alt }}" class="actu-image" loading="lazy">
                {% endif %}
                
                <h2>{{ item.categorie }}</h2>
                
                <div class="actu-content">
                    {# Boucle sur les événements/blocs internes de cette catégorie #}
                    {% for bloc in item.blocs %}
                        <p class="actu-date">{{ bloc.date }}</p>
                        
                        {# Logiciel structurel HTML simplifié #}
                        <div class="{% if bloc.miniature %}alignement{% else %}actu-wrapper{% endif %}">
                            
                            {# Rendu de la miniature (affiche) depuis le dossier user/data avec base_url_simple #}
                            {% if bloc.miniature %}
                                <img src="{{ base_url_simple ~ '/' ~ 'user/data/flex-objects/actualites/' ~ bloc.miniature }}" width="80" height="80" alt="{{ bloc.miniature_alt }}" style="object-fit: cover;" loading="lazy">
                                
                                <div class="actu-wrapper">
                            {% endif %}
                            
                            <h3 class="actu-titre">{{ bloc.titre }}</h3>
                            
                            {# Sécurité : Utilisation du filtre markdown pour le texte enrichi #}
                            <div class="actu-resume">
                                {{ bloc.resume | markdown | raw }}
                            </div>
                            
                            {# Boucle automatique pour afficher les boutons de liens s'ils existent #}
                            {% if bloc.liens %}
                                {% for lien in bloc.liens %}
                                    <p class="actu-action">
                                        {% set is_external = lien.url starts with 'http' or lien.url starts with '//' %}
                                        <a href="{{ lien.url }}" 
                                           data-type="{{ is_external ? 'external' : 'internal' }}"
                                           {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}>
                                            {{ lien.texte }}
                                        </a>
                                        {% if is_external %}
                                            <span class="lien-e-seul" aria-hidden="true"></span>
                                        {% endif %}
                                    </p>
                                {% endfor %}
                            {% endif %}
                            
                            {# Fermeture conditionnelle propre #}
                            {% if bloc.miniature %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </article>
        {% endfor %}
    </div>
    {% endif %}
{% endblock %}