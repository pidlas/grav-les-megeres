{% extends 'main-layout.html.twig' %}

{% block content %}
            
    {# On récupère dynamiquement le sous-titre défini dans le fichier .md #}
    <h2 class="coco sous-titre-page">{{ page.header.sous_titre }}</h2>

    {# 2. Affichage automatique des 2 images contenant le mot-clé 'top' #}
    <div class="img-centre">
        {% set images_affichees = 0 %}
        
        {% for image in page.media.images %}
            {# On cherche 'top' dans le nom du fichier et on limite le compteur à 2 #}
            {% if 'top' in image.filename and images_affichees < 2 %}
                {{ image.html('Un spectacle du Théâtre Forum : 0\'Pression', 'Un spectacle du Théâtre Forum : 0\'Pression', 'photo-stages-ateliers')|raw }}
                {% set images_affichees = images_affichees + 1 %}
            {% endif %}
        {% endfor %}
    </div>

    {# 3. Le reste de votre contenu Markdown ("C'EST QUOI ?", paragraphes, etc.) #}
    {{ page.content|raw }}

{% endblock %}