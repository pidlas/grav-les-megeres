{% extends 'main-layout.html.twig' %}

{% block content %}
<main>
    {# 🚀 On force la classe "reglement-interieur" si on est sur la bonne page #}
    <section class="{% if page.slug == 'reglement-interieur' %}reglement-interieur{% else %}{{ page.slug }}{% endif %}">

        {# 🎯 SOLUTION INFAILLIBLE : Balise style directe, à l'abri du pipeline de Grav #}
        {% if page.slug == 'reglement-interieur' %}
            <style>
                .reglement-interieur p {
                    border-left: 0.75rem solid #f7ae56 !important;
                    border-radius: 0.5rem;
                    margin-bottom: 2rem;
                    padding-left: 1.875rem;
                }
                .reglement-interieur .important p {
                    border-left-color: #e74c3c !important;
                    background-color: rgba(231, 76, 60, 0.05) !important;
                }
            </style>
        {% endif %}

        {# 1. On récupère le contenu HTML brut produit par Grav #}
        {% set html = page.content | raw %}

        {# 2. Remplacement des paragraphes <p> par des <div class="img-centre"> #}
        {% set html_traite = html

            | regex_replace('|<p>\\s*(<img[^>]+>)\\s*</p>|', '<div class="img-centre">$1</div>')
            | regex_replace('|<p>\\s*(<img[^>]+>\\s*<img[^>]+>)\\s*</p>|', '<div class="img-centre">$1</div>')
        %}

        {# 3. SOLUTION : Regex ultra-souple pour cibler le nom du fichier n'importe où dans le <img ...> #}
        {% set html_traite = html_traite

            | regex_replace('|<img([^>]*ateliers[^>]*\\.avif[^>]*)>|', '<img class="photo-stages-ateliers"$1>')
            | regex_replace('|<img([^>]*stages[^>]*\\.avif[^>]*)|', '<img class="photo-stages-ateliers"$1')
            | regex_replace('|<img([^>]*les-stages-[^>]*\\.avif[^>]*)>|', '<img class="affiche-stage"$1>')
        %}

        {# 4. AJOUT : On applique le remplacement des listes <ul> sur le HTML déjà traité par les étapes précédentes #}
        {#<div class="content-list">#}
            {# On remplace la balise <ul> générée par Grav par votre balise personnalisée #}
            {{ html_traite|replace({'<ul>': '<ul class="jolie-ombres">'})|raw }}
        {#</div>#}
    </section>
</main>
{% endblock %}