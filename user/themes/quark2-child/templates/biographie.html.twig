{% extends 'main-layout.html.twig' %}

{% block content %}
<main>
    <section>

        {# Habillage commun du haut #}
        <div class="conteneur-champignons">
            <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
            <h1>{{ page.title }}</h1>
            {% if page.header.subtitle %}<p class="sous-titre">{{ page.header.subtitle | raw }}</p>{% endif %}
        </div>

        <article class="g_bio">

            {# ÉLÉMENT 1 : LA PHOTO (Sécurisée : ne s'affiche que si l'image existe) #}
            <div class="e_photo">
                {% if page.header.personne_image and page.media[page.header.personne_image] %}
                    {# Grav génère l'URL relative de l'image automatiquement #}
                    <img class="fade-zoom text-image-loaded" 
                        src="{{ page.media[page.header.personne_image].url }}" 
                        alt="{{ page.header.image_alt|default(page.title) }}">
                {% endif %}
            </div>

            {# ÉLÉMENT 2 : LE DÉBUT DE LA BIO + LA CITATION #}
            <div class="e_debut_bio">
                {# page.summary récupère tout le texte situé AVANT le marqueur === #}
                {{ page.summary|raw }}

                {# BLOC CITATION (Sécurisé : s'affiche uniquement si une citation est remplie) #}
                {% if page.header.citation %}
                    <figure class="bio">
                        <blockquote>
                            <p class="theseasonsbold">&ldquo;&nbsp;{{ page.header.citation }}&nbsp;&rdquo;</p>
                        </blockquote>
                        {% if page.header.citation_auteur %}
                            <figcaption>
                                <span class="theseasonsregular">{{ page.header.citation_auteur }}</span>
                            </figcaption>
                        {% endif %}
                    </figure>
                {% endif %}
            </div>

            {# ÉLÉMENT 3 : LA FIN DE LA BIO #}
            {# On vérifie si le contenu complet est plus grand que le résumé #}
            {% if page.content|length > page.summary|length %}
                <div class="e_fin_bio">
                    {# On affiche le reste du texte #}
                    {{ page.content|slice(page.summary|length)|raw }}
                </div>
            {% endif %}

        </article>
    </section>
</main>
{% endblock %}