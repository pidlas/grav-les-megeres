{% extends 'main-layout.html.twig' %}

{% block content %}
<main>
    <section class="{{ page.slug }}">
        <div class="conteneur-champignons">
            <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
            <h1>{{ page.title }}</h1>
            {% if page.header.subtitle %}<p class="sous-titre">{{ page.header.subtitle | raw }}</p>{% endif %}
        </div>

        <div class="page-content">
            <div class="p_theatre-d-ombres">
                {% set prefixe_site = (grav.uri.host == 'grav.lesmegeresdelhumus.fr') ? '/grav' : '' %}
                
                {% set url_ombres = prefixe_site ~ '/spectacles/gresilhette-et-la-salimonde/theatre-d-ombres' %}
                {% set url_sieste  = prefixe_site ~ '/spectacles/gresilhette-et-la-salimonde/sieste-contee' %}
                {% set url_projet  = prefixe_site ~ '/spectacles/gresilhette-et-la-salimonde/projet-pedagogique' %}

                {% set menu_shortcodes %}
                    [a url="{{ url_ombres }}" class="{{ page.slug != 'theatre-d-ombres' ? 'image-wrapper morph' : '' }}" alt="Voir le théâtre d'ombres"]
                        [img class="img-menu-spectacle" name="parent://sp_theatre-d-ombres.avif" alt="Le théâtre d'ombres - Grésilhette et la Salimonde" /]
                    [/a]
                    [a url="{{ url_sieste }}" class="{{ page.slug != 'sieste-contee' ? 'image-wrapper morph' : '' }}" alt="Voir la sieste contée"]
                        [img class="img-menu-spectacle" name="parent://sp_sieste-contee.avif" alt="La sieste contée - Grésilhette et la Salimonde" /]
                    [/a]
                    [a url="{{ url_projet }}" class="{{ page.slug != 'projet-pedagogique' ? 'image-wrapper morph' : '' }}" alt="Voir le projet pédagogique"]
                        [img class="img-menu-spectacle" name="parent://sp_projet-pedagogique.avif" alt="Le projet pédagogique - Grésilhette et la Salimonde" /]
                    [/a]
                {% endset %}
                {{ menu_shortcodes | shortcodes | raw }}
            </div>

            {% if page.slug == 'theatre-d-ombres' %}
                <div class="montage-wrapper">
                    <h2 class="display-title">Nos sources d'inspiration</h2>
                    {% set img_inspiration %}[img name="montage-inspiration.avif" class="forme-montage" alt="Photos donnant de l'inspiration" /]{% endset %}
                    {{ img_inspiration | shortcodes | raw }}
                    {{ page.content | raw }}
                </div>
            {% elseif page.slug == 'sieste-contee' %}
                <div class="sieste-wrapper">
                    {{ page.content | raw }}
                    {% if page.media['sigean.avif'] %}
                        <div class="image-centree">
                            {% set img_sieste %}[img class="sigean-sieste-contee" name="sigean.avif" alt="Illustration de la sieste contée" /]{% endset %}
                            {{ img_sieste | shortcodes | raw}}
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <div class="projet-wrapper">
                    {{ page.content | raw }}
                </div>
            {% endif %}
            
            {% set configuration_fiches = {
                'theatre-d-ombres': {'pdf': 'fiche-theatre-d-ombres.pdf', 'img': 'btn-tech-ombres.avif'},
                'sieste-contee': {'pdf': 'fiche-sieste-contee.pdf', 'img': 'btn-tech-sieste.avif'},
                'projet-pedagogique': {'pdf': 'fiche-fiche-projet-pedagogique.pdf', 'img': 'btn-tech-projet.avif'}
            } %}

            {% set fiche = configuration_fiches[page.slug] %}
            
            {% if fiche and page.media[fiche.img] %}
                <p>Voir ci-dessous la fiche technique.</p>
                <div class="g_art-tech">
                    {% set fiche_shortcode %}
                        [a url="{{ prefixe_site ~ page.route ~ '/' ~ fiche.pdf }}" alt="Visualiser la fiche technique"]
                            [img class="btn-pdf" name="{{ fiche.img }}" alt="Fiche technique de la compagnie Les Mégères de l'Humus" /]
                        [/a]
                    {% endset %}
                    {{ fiche_shortcode | shortcodes | raw }}
                </div>
            {% endif %}
        </div>      
    </section>
</main>
{% endblock %}
