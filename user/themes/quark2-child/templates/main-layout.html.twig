<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ page.title }}</title>
    <link rel="stylesheet" href="{{ url('theme://css/style.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/custom.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/all.min.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/video.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/audio.css') }}" type="text/css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# Injection automatique du SEO de Grav si disponible #}
    {% block meta %}{% endblock %}

    {# --- AJOUT CYBLÉ SUR LA PAGE SPECTACLE --- #}
    {% if page.slug == 'gresilhette-et-la-salimonde' %}
    <style>
        .encadre:before, 
        .encadre-lenga:before, 
        .encadre-extrait:before {
            background-image: image-set(
                url('{{ page.media["livre-blanc-fleur-remplie.webp"].url }}') type("image/webp"),
                url('{{ page.media["livre-blanc-fleur-remplie.png"].url }}') type("image/png")
            ) !important;
        }
    </style>
    {% endif %}
</head>
<body>
    <div class="wrapper">
        {# 1. En-tête du site #}
        {% include 'partials/header.html.twig' %}
        {# 2. CAS DE LA PAGE D'ACCUEIL (Présence de slides) #}
        {% if page.header.slides %}
            <main>
                <section>
                    {# A. On affiche d'abord les champignons et le titre de l'accueil #}
                    <div class="conteneur-champignons">
                        <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
                        <h1>{{ page.title }}</h1>
                    </div>
                </section>
            </main>
            {# B. On affiche le Diaporama juste en dessous #}
            {% include 'partials/diaporama.html.twig' %}
            <main>
                <section>
                    {# C. On affiche enfin le texte de l'accueil en dessous du diaporama #}
                    <div class="page-content">
                        <p>Les Mégères de l'Humus est une <a data-type="internal" href="{{ base_url_relative }}/infos/compagnie">compagnie</a><span class="lien-i-seul"></span> 
                        de théâtre éco-queer, féministe et artiviste installée à Moussoulens, dans l'Aude. Nous créons des <a data-type="internal" href="{{ base_url_relative }}/spectacles/gresilhette-et-la-salimonde">spectacles</a>
                        <span class="lien-i-seul"></span>, menons des actions de <a data-type="internal" href="{{ base_url_relative }}/theatre-forum/presentation">théâtre forum</a>
                        <span class="lien-i-seul"></span> et proposons des <a data-type="internal" href="{{ base_url_relative }}/prestations/ateliers">ateliers</a>
                        <span class="lien-i-seul"></span>, <a data-type="internal" href="{{ base_url_relative }}/prestations/cours">cours</a>
                        <span class="lien-i-seul"></span> et <a data-type="internal" href="{{ base_url_relative }}/prestations/stages">stages</a>
                        <span class="lien-i-seul"></span> pour différents publics. 
                        {# Sécurisation du lien de contact pour éviter le crash global #}
                        Nous sommes joignables <a data-type="internal" href="{{ base_url_relative }}/contact">ici</a><span class="lien-i-seul"></span>.</p>
                    </div>
                </section>
            </main>
        {# 3. CAS DES AUTRES PAGES DU SITE (Pas de slides) #}
        {% else %}
            {# On appelle le bloc classique qui exécutera votre fichier default.html.twig normalement #}
            {% block content %}{% endblock %}
        {% endif %}
        {# 4. Image décorative du bas : Feuilles (toujours au-dessus du footer) #}
        <div class="conteneur-feuilles">
            <img src="{{ url('theme://images/i_feuilles.svg') }}" class="feuilles" alt="" loading="lazy">
        </div>
        {# 5. Pied de page du site #}
        {% include 'partials/footer.html.twig' %}
    </div>
    {# Vos scripts JS #}
    <script src="{{ url('theme://js/app.js') }}"></script>
    <script src="{{ url('theme://js/audio.js') }}"></script>
    <script src="{{ url('theme://js/video.js') }}"></script>
    <script src="{{ url('theme://js/don-ha.js') }}"></script>
    <script src="{{ url('theme://js/menu-active-state.js') }}"></script>
</body>
</html>