<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
 
    {# 1. TITRE D'ONGLET SEO #}
    {% block head_title %}
    <title>{% if page.title %}{{ page.title|e }}{% else %}{{ site.title|e }}{% endif %}</title>
    {% endblock %}
 
    {# 2. BALISES MÉTADONNÉES SEO #}
    {% block head_meta %}
    <meta name="description" content="{% if page.header.metadata.description %}{{ page.header.metadata.description|e }}{% else %}{{ site.metadata.description|e }}{% endif %}" />
    <meta name="robots" content="{% if page.header.metadata.robots %}{{ page.header.metadata.robots|e }}{% else %}index, follow{% endif %}" />
    <link rel="canonical" href="{{ page.url(true, true)|e }}" />
    {% endblock %}
 
    {# 3. BALISES POUR LES RÉSEAUX SOCIAUX (OPENGRAPH) #}
    {% block head_opengraph %}
    <meta property="og:site_name" content="{{ site.title|e }}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{% if page.title %}{{ page.title|e }}{% else %}{{ site.title|e }}{% endif %}" />
    <meta property="og:description" content="{% if page.header.metadata.description %}{{ page.header.metadata.description|e }}{% else %}{{ site.metadata.description|e }}{% endif %}" />
    <meta property="og:url" content="{{ page.url(true, true)|e }}" />
    <meta property="og:image" content="{{ uri.rootUrl(true) ~ url('theme://images/logohumous-notext-blue.png', false) }}" />
    <meta property="og:image:alt" content="Logo de la compagnie {{ site.title|e }}" />
    {% endblock %}
 
    {# 4. FEUILLES DE STYLE (Vos balises en dur qui marchent à tous les coups !) #}
    <link rel="stylesheet" href="{{ url('theme://css/style.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/custom.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/all.min.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/video.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/audio.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ url('theme://css/spectacle-opression.css') }}" type="text/css" />

    <link rel="icon" type="image/png" href="{{ url('theme://images/favicon/favicon-48x48.png') }}" />
    <link rel="icon" type="image/svg+xml" href="{{ url('theme://images/favicon/favicon.svg') }}" />
    <link rel="shortcut icon" href="{{ url('theme://images/favicon/favicon.ico') }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ url('theme://images/favicon/apple-touch-icon.png') }}" />

    {# 5. LE BLOC MAGIQUE : Plus de "if page.slug" ici. Il est vide et attend qu'une page l'utilise #}
    {% block custom_styles %}{% endblock %}

    {# 6. DONNÉES STRUCTURÉES (SCHEMA.ORG) #}
    {% block head_jsonld %}
    {% set absolute_root = uri.rootUrl(true) %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "{{ absolute_root }}/#organization",
          "name": "{{ site.title|e }}",
          "url": "{{ absolute_root }}",
          "logo": "{{ absolute_root }}{{ url('theme://images/logohumous-notext-blue.png', false) }}",
          "email": "compagnie@lesmegeresdelhumus.fr",
          "sameAs": [ "https://facebook.com", "https://instagram.com" ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "7 rue du 19 mars 1962",
            "postalCode": "11170",
            "addressLocality": "Moussoulens",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "WebSite",
          "@id": "{{ absolute_root }}/#website",
          "url": "{{ absolute_root }}",
          "name": "{{ site.title|e }}",
          "publisher": { "@id": "{{ absolute_root }}/#organization" },
          "inLanguage": "fr"
        }
      ]
    }
    </script>
    {% endblock %}

    {% block meta %}{% endblock %}

    {# 🌟 ANCRE SYSTEME 1 : Permet à Grav d'injecter les CSS internes de sa barre de débogage #}
    {{ assets.css() | raw }}

</head>

<body>

    <div class="wrapper">
        {# En-tête unique du site #}
        {% include 'partials/header.html.twig' %}
        
        <main id="main-content" tabindex="-1">
            {# Zone commune du haut (Champignons + Titres dynamiques) #}
            <section class="{{ page.slug }}">

                <div class="conteneur-champignons">
                    <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
                            
                    {% set vraie_page_url = page.find(uri.path) %}

                    {% set titre_brut = vraie_page_url.title | default(page.title) %}

                    {% set titre_decoupe = titre_brut|split('|') %}
                    <h1>{{ titre_decoupe[0]|trim }}</h1>
                           
                    {% set sous_titre = vraie_page_url.header.subtitle | default(page.header.subtitle) %}
                    {% if sous_titre %}
                        <p class="sous-titre">{{ sous_titre | raw }}</p>
                    {% endif %}
                </div>

                {# LE BLOC MAGIQUE DU DIAPORAMA #}
                {% block avant_conteneur_texte %}{% endblock %}

                {# LE CŒUR UNIQUE DU SITE : Tout le contenu spécifique s'injectera ici #}
                {% block content %}{% endblock %}
            </section>
        </main>

        {# Zone commune du bas (Feuilles) #}
        <div class="conteneur-feuilles">
            <img src="{{ url('theme://images/i_feuilles.svg') }}" class="feuilles" alt="" loading="lazy">
        </div>

        {# Pied de page unique #}
        {% include 'partials/footer.html.twig' %}
    </div>

    {# Vos scripts JS #}
    {% do assets.addJs('jquery', 101) %}
    {{ assets.js() | raw }}
    <script src="{{ url('theme://js/navigation.js') }}"></script>
    <script src="{{ url('theme://js/audio.js') }}"></script>
    <script src="{{ url('theme://js/video.js') }}"></script>
    <script src="{{ url('theme://js/don-ha.js') }}"></script>

    {# 🌟 COMMANDE FORCEE : On oblige Grav à injecter le script de la Debugbar ICI, dans le HTML #}
    {% if grav.debugger %}
        {{ grav.debugger.assets|raw }}
    {% endif %}

    {# 🌟 ANCRE SYSTEME 2 : Permet à Grav d'injecter la debugbar et ses scripts de pied de page #}
    {{ assets.js('bottom') | raw }}
</body>
</html>
