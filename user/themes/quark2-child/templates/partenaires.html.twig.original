{% extends 'main-layout.html.twig' %}

{% block content %}

    {# 🌟 ALIGNEMENT TOTAL SUR LE MODÈLE GRÉSILHETTE / COMPAGNIE #}
    {% set liste_partenaires = grav['flex'].collection('partenaires') %}

    {% if liste_partenaires is not empty %}
        <ul class="g_partenaires">
            
            {% for partenaire in liste_partenaires %}
                <li>
                    <div class="partenaire-carte-pro">
                        
                        {% set alt_text = partenaire.nom is not empty ? partenaire.nom : 'Logo partenaire' %}
                        
                        {% if partenaire.url %}
                            <a href="{{ partenaire.url }}" target="_blank" rel="noopener noreferrer">
                        {% endif %}

                        {# 🌟 EXTRACTION SÉCURISÉE : On intercepte la clé du tableau Flex (le chemin physique) #}
                        {% if partenaire.image is not empty %}
                            {% set path_logo = partenaire.image | keys | first %}
                            <img src="{{ base_url_simple ~ '/' ~ path_logo }}" alt="{{ alt_text }}" class="partenaire-logo-pro" loading="lazy">
                        {% else %}
                            <h3 class="partenaire-titre-pro">{{ alt_text }}</h3>
                        {% endif %}

                        {% if partenaire.url %}
                            </a>
                            <a href="{{ partenaire.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary partenaire-btn-pro">
                                Visiter le site
                            </a>
                        {% endif %}
                        
                    </div>
                </li>
            {% endfor %}
            
        </ul>
    {% endif %}

    {# Affichage propre du texte de description du bas depuis la page d'aiguillage #}
    {{ page.content | raw }}

{% endblock %}