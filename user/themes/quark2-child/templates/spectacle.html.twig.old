{% extends 'main-layout.html.twig' %}

{% block content %}
<main>
    <section class="{{ page.slug }}">

        {# Habillage commun du haut #}
        <div class="conteneur-champignons">
            <img src="{{ url('theme://images/i_champignons.svg') }}" class="champignons" alt="" loading="lazy">
            <h1>{{ page.title }}</h1>
            {% if page.header.subtitle %}<p class="sous-titre">{{ page.header.subtitle | raw }}</p>{% endif %}
        </div>

        <div class="page-content">
            {# 1. Menu des 3 images en rond (commun) #}
            <div class="p_theatre-d-ombres">
                <a class="{{ page.slug != 'theatre-d-ombres' ? 'image-wrapper morph' : '' }}" href="{{ page.parent.url }}/theatre-d-ombres" title="Voir le théâtre d'ombres">
                    <img src="{{ page.parent.media['sp_theatre-d-ombres.avif'].resize(200, 200).quality(85).url }}" alt="Le théâtre d'ombres - Grésilhette et la Salimonde">
                </a>
                <a class="{{ page.slug != 'sieste-contee' ? 'image-wrapper morph' : '' }}" href="{{ page.parent.url }}/sieste-contee" title="Voir la sieste contée">
                    <img src="{{ page.parent.media['sp_sieste-contee.avif'].resize(200, 200).quality(85).url }}" alt="La sieste contée - Grésilhette et la Salimonde">
                </a>
                <a class="{{ page.slug != 'projet-pedagogique' ? 'image-wrapper morph' : '' }}" href="{{ page.parent.url }}/projet-pedagogique" title="Voir le projet pédagogique">
                    <img src="{{ page.parent.media['sp_projet-pedagogique.avif'].resize(200, 200).quality(85).url }}" alt="Le projet pédagogique - Grésilhette et la Salimonde">
                </a>
            </div>

            {# 2. Section Contenu : s'adapte selon la page #}
            {% if page.slug == 'theatre-d-ombres' %}
                <div class="montage-wrapper">
                    <h2 class="display-title">Nos sources d'inspiration</h2>
                    <img class="forme-montage" alt="Photos donnant de l'inspiration" src="{{ page.media['montage-inspiration.jpg'].url }}" loading="lazy">
                    {{ page.content | raw }}
                </div>
            {% elseif page.slug == 'sieste-contee' %}
                <div class="sieste-wrapper">
                    {{ page.content | raw }}
                    {# Image centrée en dessous pour la sieste #}
                    {% if page.media['visuel-sieste.jpg'] %}
                        <div class="image-centree">
                            <img src="{{ page.media['sigean.webp'].url }}" alt="Illustration de la sieste contée" loading="lazy">
                        </div>
                    {% endif %}
                </div>
            {% else %}
                {# Projet pédagogique : que du texte #}
                <div class="projet-wrapper">
                    {{ page.content | raw }}
                </div>
            {% endif %}
            
            {# 3. Fiches techniques et boutons de fin (dynamiques) #}
            {% set configuration_fiches = {
                'theatre-d-ombres': {'pdf': 'fiche-theatre-d-ombres.pdf', 'img': 'btn-tech-ombres.webp'},
                'sieste-contee': {'pdf': 'fiche-sieste-contee.pdf', 'img': 'btn-tech-sieste.webp'},
                'projet-pedagogique': {'pdf': 'fiche-projet-pedagogique.pdf', 'img': 'btn-tech-projet.webp'}
            } %}

            {% set fiche = configuration_fiches[page.slug] %}
            
            {# On vérifie que l'image du bouton existe dans le dossier de la page avant d'afficher #}
            {% if fiche and page.media[fiche.img] %}
                <p>Voir ci-dessous la fiche technique.</p>
                <div class="g_art-tech">
                    <a target="_blank" rel="noopener noreferrer" href="{{ page.url }}/{{ fiche.pdf }}" title="Visualiser la fiche technique">
                        <img alt="Fiche technique de la compagnie Les Mégères de l'Humus" src="{{ page.media[fiche.img].resize(300).url }}" loading="lazy">
                    </a>
                </div>
            {% endif %}
        </div>      
    </section>
</main>
{% endblock %}