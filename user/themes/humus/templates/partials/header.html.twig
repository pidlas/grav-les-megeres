<a href="#main-content-custom" class="skip-link">Aller au contenu principal</a>

{% set accueil_flex = grav['flex'].collection('accueil')|first %}
{% set logo_site = accueil_flex.logo_seo | default('logo.png') %}



<header>
    <div class="morph logo">
        <a href="{{ home_url }}">
            <img src="{{ base_url_simple ~ '/user/data/flex-objects/accueil/' ~ logo_site }}" width="230" height="230" alt="Le logo des Mégères de l'Humus réalisé par Noam"/>
        </a>
    </div>
    <div class="e_titre">
        <div class="titre tan" role="heading" aria-level="1">
            <a href="{{ home_url }}">Les Mégères de l'Humus</a>
        </div>
        <p class="sous-titre">Compagnie éco-queer, féministe, arTiviste</p>
    </div>

    <button id="hamburger" class="menu-petit-ecran hamburger box" onclick="myBurger()" aria-label="Ouvrir le menu" aria-controls="nav-principal" aria-expanded="false">
        <div class="container-lignes">
            <div class="ligne"></div>
            <div class="ligne"></div>
            <div class="ligne"></div>
        </div>
    </button>

    <a href="{{ home_url }}" class="mobile-brand-sticky" aria-label="Accueil - Les Mégères de l'Humus">
        <img src="{{ base_url_simple ~ '/user/data/flex-objects/accueil/' ~ logo_site }}"
             alt=""
             width="32"
             height="32"
             loading="eager">
        <span class="tan">Les Mégères de l'Humus</span>
    </a>

</header>

<nav id="nav-principal" class="navbar" role="navigation">
    <a href="{{ home_url }}" class="nav-brand-sticky" aria-label="Accueil - Les Mégères de l'Humus">
        <img src="{{ base_url_simple ~ '/user/data/flex-objects/accueil/' ~ logo_site }}"
             alt=""
             width="38"
             height="38"
             loading="eager">
        <span class="tan">Les Mégères de l'Humus</span>
    </a>

    {% include 'partials/navigation.html.twig' %}
</nav>

